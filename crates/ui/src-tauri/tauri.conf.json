{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syswatch",
  "version": "0.1.0",
  "identifier": "cz.hexel.syswatch",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Winsent",
        "width": 1180,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["blur"],
          "color": "#0e0f1299"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
