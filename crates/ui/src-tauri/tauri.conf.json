{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syswatch",
  "version": "0.1.0",
  "identifier": "cz.hexel.syswatch",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "syswatch",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
